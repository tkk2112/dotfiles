{{- if eq .chezmoi.os "linux" -}}
#!/bin/sh
set -eu

# proton-pass-ssh-agent-revision: 2
# agent launcher hash: {{ include "dot_local/bin/executable_proton-pass-ssh-agent.tmpl" | sha256sum }}
# configured-agent: {{ .sshAgent }}
# configured-vault: {{ .sshVault }}

if [ "${DOTFILES_CI:-}" = "true" ]; then
  exit 0
fi

command -v systemctl >/dev/null 2>&1 || exit 0

unit="proton-pass-ssh-agent.service"

if [ "{{ .sshAgent }}" = "proton-pass" ]; then
  systemctl --user daemon-reload
  systemctl --user enable "$unit"
  systemctl --user restart "$unit"
else
  systemctl --user disable --now "$unit" >/dev/null 2>&1 || true
  systemctl --user daemon-reload >/dev/null 2>&1 || true
fi
{{- end }}
