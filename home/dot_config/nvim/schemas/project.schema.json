{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Neovim project settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "global"
  ],
  "properties": {
    "global": {
      "$ref": "#/$defs/settings"
    },
    "languages": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/settings"
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "$ref": "#/$defs/fileSettings"
          }
        ]
      }
    },
    "commands": {
      "$ref": "#/$defs/commands"
    },
    "lsp": {
      "$ref": "#/$defs/lsp"
    },
    "subprojects": {
      "$ref": "#/$defs/subprojects"
    }
  },
  "$defs": {
    "optionValue": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": [
              "boolean",
              "number",
              "string"
            ]
          }
        }
      ]
    },
    "vimSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "opt": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/optionValue"
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vim": {
          "$ref": "#/$defs/vimSettings"
        },
        "save_on_focus": {
          "type": "boolean"
        },
        "format_on_save": {
          "type": "boolean"
        }
      }
    },
    "fileSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "filetype": {
          "type": "string",
          "minLength": 1
        },
        "vim": {
          "$ref": "#/$defs/vimSettings"
        },
        "save_on_focus": {
          "type": "boolean"
        },
        "format_on_save": {
          "type": "boolean"
        }
      }
    },
    "environment": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "type": "string",
          "enum": [
            "terminal",
            "quickfix",
            "quickfix-watch"
          ]
        },
        "focus": {
          "type": "boolean",
          "description": "Whether a terminal command should receive focus when started."
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute path or project-relative path. Supports ${projectRoot} and ${env:NAME}."
        },
        "env": {
          "$ref": "#/$defs/environment",
          "description": "Per-command environment overrides. Values support ${projectRoot}, ${cwd}, and ${env:NAME}."
        },
        "compiler": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "open": {
          "type": "string",
          "enum": [
            "always",
            "errors",
            "never"
          ]
        },
        "debounce_ms": {
          "type": "integer",
          "minimum": 50,
          "maximum": 5000,
          "description": "Milliseconds after a save before a quickfix watcher starts a validation run."
        },
        "diagnostics": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "description": "Publish watcher results as inline diagnostics. auto only publishes for buffers without an attached LSP."
        }
      }
    },
    "commands": {
      "type": "object",
      "propertyNames": {
        "pattern": "^.$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "$ref": "#/$defs/command"
          }
        ]
      }
    },
    "lspServer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "type": "array",
          "minItems": 1,
          "description": "Project-specific LSP executable and base arguments. Replaces the default server command. Supports ${projectRoot} and ${env:NAME}.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "args": {
          "type": "array",
          "description": "Arguments appended to the resolved LSP command. Supports ${projectRoot} and ${env:NAME}.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "settings": {
          "type": "object",
          "description": "Project-specific LSP settings. String values support ${projectRoot} and ${env:NAME}."
        },
        "init_options": {
          "type": "object",
          "description": "Project-specific LSP initialization options. String values support ${projectRoot} and ${env:NAME}."
        }
      }
    },
    "lsp": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/lspServer"
      }
    },
    "subproject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "description": "Project-relative root directory for the subproject."
        },
        "config": {
          "type": "string",
          "minLength": 1,
          "description": "Optional project-relative settings file under the project's top-level .nvim directory."
        }
      }
    },
    "subprojects": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/subproject"
      }
    }
  }
}
