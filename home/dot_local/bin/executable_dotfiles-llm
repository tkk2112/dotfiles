#!/bin/sh
set -eu

usage() {
  cat <<'EOF'
Usage:
  dotfiles-llm runtimes
  dotfiles-llm models [kind]
  dotfiles-llm status [runtime]
  dotfiles-llm is-running <runtime>
  dotfiles-llm acquire <runtime> <pid>
  dotfiles-llm release <runtime> <pid>
  dotfiles-llm start <runtime>
  dotfiles-llm stop <runtime>
  dotfiles-llm decide <questions.json>
EOF
}

die() {
  printf 'dotfiles-llm: %s\n' "$*" >&2
  exit 1
}

require_darwin() {
  [ "$(uname -s)" = "Darwin" ] \
    || die "LLM runtimes are currently supported only on macOS"
}

LLM_DATA="$(chezmoi data)"

llm_data() {
  printf '%s\n' "$LLM_DATA"
}

runtime_exists() {
  name="$1"

  llm_data \
    | jq -e --arg name "$name" \
      '.llm.runtimes[$name] != null' >/dev/null
}

runtime_enabled() {
  name="$1"

  llm_data \
    | jq -e --arg name "$name" '
      .llm.runtimes[$name] as $runtime
      | .llmConfig as $config
      |
        $runtime != null
        and ($runtime | if has("enabled") then .enabled else true end)
        and (($config.features // []) | index($runtime.feature) != null)
        and (($config.disabledRuntimes // []) | index($name) == null)
    ' >/dev/null
}

runtime_label() {
  printf 'com.dotfiles.llm-%s\n' "$1"
}

runtime_plist() {
  printf '%s/Library/LaunchAgents/%s.plist\n' \
    "$HOME" "$(runtime_label "$1")"
}

runtime_domain() {
  printf 'gui/%s\n' "$(id -u)"
}

runtime_target() {
  printf '%s/%s\n' "$(runtime_domain)" "$(runtime_label "$1")"
}

runtime_autostart() {
  name="$1"

  llm_data \
    | jq -e --arg name "$name" '
      .llm.runtimes[$name] as $runtime
      | .llmConfig as $config
      |
        $runtime != null
        and ($runtime | if has("autostart") then .autostart else false end)
        and (($config.manualRuntimes // []) | index($name) == null)
    ' >/dev/null
}

llm_state_root() {
  printf '%s/dotfiles/llm\n' "${XDG_STATE_HOME:-$HOME/.local/state}"
}

runtime_lease_dir() {
  printf '%s/leases/%s\n' "$(llm_state_root)" "$1"
}

runtime_owned_file() {
  printf '%s/owned/%s\n' "$(llm_state_root)" "$1"
}

runtime_lock_dir() {
  printf '%s/locks/%s.lock\n' "$(llm_state_root)" "$1"
}

validate_pid() {
  case "$1" in
    '' | *[!0-9]*)
      die "invalid pid: $1"
      ;;
  esac
}

SERVICE_LOCK=""

acquire_runtime_lock() {
  name="$1"
  root="$(llm_state_root)"

  mkdir -p "$root/locks"

  SERVICE_LOCK="$(runtime_lock_dir "$name")"

  attempts=0

  while ! mkdir "$SERVICE_LOCK" 2>/dev/null; do
    holder=""

    if [ -f "$SERVICE_LOCK/pid" ]; then
      holder="$(cat "$SERVICE_LOCK/pid" 2>/dev/null || true)"
    fi

    case "$holder" in
      '' | *[!0-9]*)
        ;;
      *)
        if ! kill -0 "$holder" 2>/dev/null; then
          rm -f "$SERVICE_LOCK/pid"
          rmdir "$SERVICE_LOCK" 2>/dev/null || true
          continue
        fi
        ;;
    esac

    attempts=$((attempts + 1))

    [ "$attempts" -lt 100 ] \
      || die "timed out waiting for service lock: $name"

    sleep 0.05
  done

  printf '%s\n' "$$" >"$SERVICE_LOCK/pid"
}

release_runtime_lock() {
  [ -n "$SERVICE_LOCK" ] || return 0

  rm -f "$SERVICE_LOCK/pid"
  rmdir "$SERVICE_LOCK" 2>/dev/null || true

  SERVICE_LOCK=""
}

cleanup_stale_leases() {
  name="$1"
  dir="$(runtime_lease_dir "$name")"

  [ -d "$dir" ] || return 0

  for lease in "$dir"/*; do
    [ -f "$lease" ] || continue

    pid="${lease##*/}"

    case "$pid" in
      '' | *[!0-9]*)
        rm -f "$lease"
        continue
        ;;
    esac

    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$lease"
    fi
  done
}

has_runtime_leases() {
  dir="$(runtime_lease_dir "$1")"

  [ -d "$dir" ] || return 1

  for lease in "$dir"/*; do
    [ -f "$lease" ] && return 0
  done

  return 1
}

list_runtimes() {
  printf '%-18s %-14s %-10s %-10s %-24s %s\n' \
    "NAME" "FEATURE" "STATE" "START" "MODEL" "PORT"

  llm_data \
    | jq -r '
      .llmConfig as $config
      | .llm.runtimes
      | to_entries[]
      | .key as $name
      | .value as $runtime
      | ($runtime | if has("enabled") then .enabled else true end) as $catalog_enabled
      | (($config.features // []) | index($runtime.feature) != null) as $feature_enabled
      | (($config.disabledRuntimes // []) | index($name) == null) as $machine_enabled
      | ($runtime | if has("autostart") then .autostart else false end) as $catalog_autostart
      | (($config.manualRuntimes // []) | index($name) == null) as $machine_autostart
      | [
          $name,
          ($runtime.feature // "-"),
          (
            if $catalog_enabled and $feature_enabled and $machine_enabled
            then "enabled"
            else "disabled"
            end
          ),
          (
            if $catalog_autostart and $machine_autostart
            then "autostart"
            else "manual"
            end
          ),
          $runtime.model,
          ($runtime.port | tostring)
        ]
      | @tsv
    ' \
    | while IFS="$(printf '\t')" read -r name feature state start model port; do
      printf '%-18s %-14s %-10s %-10s %-24s %s\n' \
        "$name" "$feature" "$state" "$start" "$model" "$port"
    done
}

list_models() {
  kind="${1:-}"

  if [ -n "$kind" ]; then
    llm_data \
      | jq -r --arg kind "$kind" '
        .llm.models[]
        | select(.kind == $kind)
        | [
            .id,
            .name,
            .kind,
            (.context | tostring),
            (.engines | keys | join(","))
          ]
        | @tsv
      '
  else
    llm_data \
      | jq -r '
        .llm.models[]
        | [
            .id,
            .name,
            .kind,
            (.context | tostring),
            (.engines | keys | join(","))
          ]
        | @tsv
      '
  fi
}

status_runtime() {
  name="$1"

  runtime_exists "$name" \
    || die "unknown runtime: $name"

  data="$(llm_data)"

  feature="$(
    printf '%s\n' "$data" \
      | jq -r --arg name "$name" '.llm.runtimes[$name].feature'
  )"

  model="$(
    printf '%s\n' "$data" \
      | jq -r --arg name "$name" '.llm.runtimes[$name].model'
  )"

  port="$(
    printf '%s\n' "$data" \
      | jq -r --arg name "$name" '.llm.runtimes[$name].port'
  )"

  if runtime_enabled "$name"; then
    enabled="yes"
  else
    enabled="no"
  fi

  if runtime_autostart "$name"; then
    autostart="yes"
  else
    autostart="no"
  fi

  target="$(runtime_target "$name")"
  log="$HOME/Library/Logs/dotfiles/llm-$name.err.log"

  if [ "$enabled" != "yes" ]; then
    state="disabled"
  elif launchctl print "$target" 2>/dev/null \
    | grep -q 'state = running'; then
    state="running"
  elif launchctl print "$target" >/dev/null 2>&1; then
    state="loaded"
  else
    state="stopped"
  fi

  printf '%s\n' "$name"
  printf '  state:     %s\n' "$state"
  printf '  feature:   %s\n' "$feature"
  printf '  model:     %s\n' "$model"
  printf '  endpoint:  http://127.0.0.1:%s\n' "$port"
  printf '  enabled:   %s\n' "$enabled"
  printf '  autostart: %s\n' "$autostart"

  if [ -f "$log" ]; then
    printf '\n'
    printf '  recent log:\n'
    tail -n 5 "$log" \
      | sed 's/^/    /'
  fi
}

status_all() {
  llm_data \
    | jq -r '.llm.runtimes | keys[]' \
    | while IFS= read -r name; do
      status_runtime "$name"
    done
}

is_runtime_running() {
  name="$1"

  require_darwin

  if ! runtime_exists "$name"; then
    printf 'dotfiles-llm: unknown runtime: %s\n' "$name" >&2
    return 2
  fi

  if ! runtime_enabled "$name"; then
    printf 'dotfiles-llm: runtime is disabled: %s\n' "$name" >&2
    return 2
  fi

  target="$(runtime_target "$name")"

  if launchctl print "$target" 2>/dev/null \
    | grep -q 'state = running'; then
    return 0
  fi

  return 1
}

start_runtime() {
  name="$1"

  require_darwin

  runtime_exists "$name" \
    || die "unknown runtime: $name"

  runtime_enabled "$name" \
    || die "runtime is disabled: $name"

  plist="$(runtime_plist "$name")"
  target="$(runtime_target "$name")"

  [ -f "$plist" ] \
    || die "runtime is not installed: $plist"

  if ! launchctl print "$target" >/dev/null 2>&1; then
    launchctl bootstrap "$(runtime_domain)" "$plist"
  fi

  launchctl kickstart -k "$target"
}

stop_runtime() {
  name="$1"

  require_darwin

  runtime_exists "$name" \
    || die "unknown runtime: $name"

  launchctl bootout "$(runtime_target "$name")" >/dev/null 2>&1 || true
}

acquire_runtime() {
  name="$1"
  pid="$2"

  require_darwin
  validate_pid "$pid"

  runtime_exists "$name" \
    || die "unknown runtime: $name"

  runtime_enabled "$name" \
    || die "runtime is disabled: $name"

  # launchd owns autostart runtimes. They never need client leases.
  if runtime_autostart "$name"; then
    return 0
  fi

  root="$(llm_state_root)"
  leases="$(runtime_lease_dir "$name")"
  owned="$(runtime_owned_file "$name")"

  mkdir -p "$leases" "$root/owned"

  acquire_runtime_lock "$name"
  trap 'release_runtime_lock' 0 1 2 15

  cleanup_stale_leases "$name"

  lease="$leases/$pid"
  : >"$lease"

  if is_runtime_running "$name"; then
    release_runtime_lock
    trap - 0 1 2 15
    return 0
  fi

  if ! start_runtime "$name"; then
    rm -f "$lease"

    release_runtime_lock
    trap - 0 1 2 15

    return 1
  fi

  # The service was stopped when we acquired it, so the lease system owns
  # this start and may stop it when the final lease disappears.
  : >"$owned"

  release_runtime_lock
  trap - 0 1 2 15
}

release_runtime() {
  name="$1"
  pid="$2"

  require_darwin
  validate_pid "$pid"

  runtime_exists "$name" \
    || die "unknown runtime: $name"

  # launchd owns autostart runtimes.
  if runtime_autostart "$name"; then
    return 0
  fi

  leases="$(runtime_lease_dir "$name")"
  owned="$(runtime_owned_file "$name")"

  acquire_runtime_lock "$name"
  trap 'release_runtime_lock' 0 1 2 15

  cleanup_stale_leases "$name"

  rm -f "$leases/$pid"

  cleanup_stale_leases "$name"

  if ! has_runtime_leases "$name" && [ -f "$owned" ]; then
    stop_runtime "$name"
    rm -f "$owned"
  fi

  release_runtime_lock
  trap - 0 1 2 15
}

decision_runtime() {
  llm_data | jq -er '.llm.defaults.decision'
}

runtime_port() {
  name="$1"

  llm_data \
    | jq -er --arg name "$name" '.llm.runtimes[$name].port'
}

wait_for_http() {
  endpoint="$1"
  attempts=0

  while ! curl -fsS "$endpoint/health" >/dev/null 2>&1; do
    attempts=$((attempts + 1))

    if [ "$attempts" -ge 120 ]; then
      return 1
    fi

    sleep 0.25
  done
}

decide() {
  request="$1"

  [ -f "$request" ] \
    || die "request file not found: $request"

  jq -e '
    type == "object"
    and has("state")
    and (.questions | type == "object")
  ' "$request" >/dev/null \
    || die "invalid decision request: expected state and questions"

  runtime="$(decision_runtime)"

  runtime_enabled "$runtime" \
    || die "decision runtime is disabled: $runtime"

  port="$(runtime_port "$runtime")"
  endpoint="http://127.0.0.1:$port"
  acquired=false

  if ! curl -fsS "$endpoint/health" >/dev/null 2>&1; then
    acquire_runtime "$runtime" "$$"
    acquired=true

    trap 'release_runtime "$runtime" "$$"' 0 1 2 15

    wait_for_http "$endpoint" \
      || die "decision runtime did not become ready: $runtime"
  fi

  curl -fsS \
    -H 'Content-Type: application/json' \
    --data-binary "@$request" \
    "$endpoint/predict"

  printf '\n'

  if [ "$acquired" = "true" ]; then
    release_runtime "$runtime" "$$"
    trap - 0 1 2 15
  fi
}

command="${1:-}"

case "$command" in
  decide)
    [ -n "${2:-}" ] || die "missing questions file"
    decide "$2"
    ;;

  runtimes | list)
    list_runtimes
    ;;

  models)
    list_models "${2:-}"
    ;;

  status)
    if [ -n "${2:-}" ]; then
      status_runtime "$2"
    else
      status_all
    fi
    ;;

  is-running)
    [ -n "${2:-}" ] || die "missing runtime"
    is_runtime_running "$2"
    ;;

  acquire)
    [ -n "${2:-}" ] || die "missing runtime"
    [ -n "${3:-}" ] || die "missing pid"
    acquire_runtime "$2" "$3"
    ;;

  release)
    [ -n "${2:-}" ] || die "missing runtime"
    [ -n "${3:-}" ] || die "missing pid"
    release_runtime "$2" "$3"
    ;;

  start)
    [ -n "${2:-}" ] || die "missing runtime"
    start_runtime "$2"
    ;;

  stop)
    [ -n "${2:-}" ] || die "missing runtime"
    stop_runtime "$2"
    ;;

  *)
    usage
    exit 1
    ;;
esac
