#!/bin/sh
set -eu

usage() {
  cat <<'EOF'
Usage:
  dotfiles-llm services
  dotfiles-llm models [type]
  dotfiles-llm status [service]
  dotfiles-llm is-running <service>
  dotfiles-llm acquire <service> <pid>
  dotfiles-llm release <service> <pid>
  dotfiles-llm start <service>
  dotfiles-llm stop <service>
EOF
}

die() {
  printf 'dotfiles-llm: %s\n' "$*" >&2
  exit 1
}

require_darwin() {
  [ "$(uname -s)" = "Darwin" ] \
    || die "LLM services are currently supported only on macOS"
}

llm_data() {
  chezmoi data
}

service_exists() {
  name="$1"

  llm_data \
    | jq -e --arg name "$name" \
      '.llm.services[$name] != null' >/dev/null
}

service_enabled() {
  name="$1"

  llm_data \
    | jq -e --arg name "$name" \
      '.llm.services[$name].enabled == true' >/dev/null
}

service_label() {
  printf 'com.dotfiles.llm-%s\n' "$1"
}

service_plist() {
  printf '%s/Library/LaunchAgents/%s.plist\n' \
    "$HOME" "$(service_label "$1")"
}

service_domain() {
  printf 'gui/%s\n' "$(id -u)"
}

service_target() {
  printf '%s/%s\n' "$(service_domain)" "$(service_label "$1")"
}

service_autostart() {
  name="$1"

  llm_data \
    | jq -e --arg name "$name" \
      '.llm.services[$name].autostart == true' >/dev/null
}

llm_state_root() {
  printf '%s/dotfiles/llm\n' "${XDG_STATE_HOME:-$HOME/.local/state}"
}

service_lease_dir() {
  printf '%s/leases/%s\n' "$(llm_state_root)" "$1"
}

service_owned_file() {
  printf '%s/owned/%s\n' "$(llm_state_root)" "$1"
}

service_lock_dir() {
  printf '%s/locks/%s.lock\n' "$(llm_state_root)" "$1"
}

validate_pid() {
  case "$1" in
    '' | *[!0-9]*)
      die "invalid pid: $1"
      ;;
  esac
}

SERVICE_LOCK=""

acquire_service_lock() {
  name="$1"
  root="$(llm_state_root)"

  mkdir -p "$root/locks"

  SERVICE_LOCK="$(service_lock_dir "$name")"

  attempts=0

  while ! mkdir "$SERVICE_LOCK" 2>/dev/null; do
    holder=""

    if [ -f "$SERVICE_LOCK/pid" ]; then
      holder="$(cat "$SERVICE_LOCK/pid" 2>/dev/null || true)"
    fi

    case "$holder" in
      '' | *[!0-9]*)
        ;;
      *)
        if ! kill -0 "$holder" 2>/dev/null; then
          rm -f "$SERVICE_LOCK/pid"
          rmdir "$SERVICE_LOCK" 2>/dev/null || true
          continue
        fi
        ;;
    esac

    attempts=$((attempts + 1))

    [ "$attempts" -lt 100 ] \
      || die "timed out waiting for service lock: $name"

    sleep 0.05
  done

  printf '%s\n' "$$" >"$SERVICE_LOCK/pid"
}

release_service_lock() {
  [ -n "$SERVICE_LOCK" ] || return 0

  rm -f "$SERVICE_LOCK/pid"
  rmdir "$SERVICE_LOCK" 2>/dev/null || true

  SERVICE_LOCK=""
}

cleanup_stale_leases() {
  name="$1"
  dir="$(service_lease_dir "$name")"

  [ -d "$dir" ] || return 0

  for lease in "$dir"/*; do
    [ -f "$lease" ] || continue

    pid="${lease##*/}"

    case "$pid" in
      '' | *[!0-9]*)
        rm -f "$lease"
        continue
        ;;
    esac

    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$lease"
    fi
  done
}

has_service_leases() {
  dir="$(service_lease_dir "$1")"

  [ -d "$dir" ] || return 1

  for lease in "$dir"/*; do
    [ -f "$lease" ] && return 0
  done

  return 1
}

list_services() {
  printf '%-18s %-12s %-10s %-10s %-12s %-24s %s\n' \
    "NAME" "TYPE" "STATE" "START" "BACKEND" "MODEL" "PORT"

  llm_data \
    | jq -r '
      .llm.services
      | to_entries[]
      | [
          .key,
          .value.type,
          (if .value.enabled then "enabled" else "disabled" end),
          (if .value.autostart then "autostart" else "manual" end),
          .value.backend,
          .value.model,
          (.value.port | tostring)
        ]
      | @tsv
    ' \
    | while IFS="$(printf '\t')" read -r name type state start backend model port; do
      printf '%-18s %-12s %-10s %-10s %-12s %-24s %s\n' \
        "$name" "$type" "$state" "$start" "$backend" "$model" "$port"
    done
}

list_models() {
  type="${1:-}"

  if [ -n "$type" ]; then
    llm_data \
      | jq -r --arg type "$type" '
        .llm.models[]
        | select(.type == $type)
        | [
            .id,
            .name,
            .type,
            (.ctx_size | tostring),
            (.backends | keys | join(","))
          ]
        | @tsv
      '
  else
    llm_data \
      | jq -r '
        .llm.models[]
        | [
            .id,
            .name,
            .type,
            (.ctx_size | tostring),
            (.backends | keys | join(","))
          ]
        | @tsv
      '
  fi
}

status_service() {
  name="$1"

  service_exists "$name" \
    || die "unknown service: $name"

  data="$(llm_data)"

  type="$(
    printf '%s\n' "$data" \
      | jq -r --arg name "$name" '.llm.services[$name].type'
  )"

  backend="$(
    printf '%s\n' "$data" \
      | jq -r --arg name "$name" '.llm.services[$name].backend'
  )"

  model="$(
    printf '%s\n' "$data" \
      | jq -r --arg name "$name" '.llm.services[$name].model'
  )"

  port="$(
    printf '%s\n' "$data" \
      | jq -r --arg name "$name" '.llm.services[$name].port'
  )"

  autostart="$(
    printf '%s\n' "$data" \
      | jq -r --arg name "$name" '
        if .llm.services[$name].autostart then "yes" else "no" end
      '
  )"

  enabled="$(
    printf '%s\n' "$data" \
      | jq -r --arg name "$name" '
        if .llm.services[$name].enabled then "yes" else "no" end
      '
  )"

  target="$(service_target "$name")"
  log="$HOME/Library/Logs/dotfiles/llm-$name.err.log"

  if [ "$enabled" != "yes" ]; then
    state="disabled"
  elif launchctl print "$target" 2>/dev/null \
    | grep -q 'state = running'; then
    state="running"
  elif launchctl print "$target" >/dev/null 2>&1; then
    state="loaded"
  else
    state="stopped"
  fi

  printf '%s\n' "$name"
  printf '  state:     %s\n' "$state"
  printf '  type:      %s\n' "$type"
  printf '  backend:   %s\n' "$backend"
  printf '  model:     %s\n' "$model"
  printf '  endpoint:  http://127.0.0.1:%s\n' "$port"
  printf '  enabled:   %s\n' "$enabled"
  printf '  autostart: %s\n' "$autostart"

  if [ -f "$log" ]; then
    printf '\n'
    printf '  recent log:\n'
    tail -n 5 "$log" \
      | sed 's/^/    /'
  fi
}

status_all() {
  llm_data \
    | jq -r '.llm.services | keys[]' \
    | while IFS= read -r name; do
      status_service "$name"
    done
}

is_service_running() {
  name="$1"

  require_darwin

  if ! service_exists "$name"; then
    printf 'dotfiles-llm: unknown service: %s\n' "$name" >&2
    return 2
  fi

  if ! service_enabled "$name"; then
    printf 'dotfiles-llm: service is disabled: %s\n' "$name" >&2
    return 2
  fi

  target="$(service_target "$name")"

  if launchctl print "$target" 2>/dev/null \
    | grep -q 'state = running'; then
    return 0
  fi

  return 1
}

start_service() {
  name="$1"

  require_darwin

  service_exists "$name" \
    || die "unknown service: $name"

  service_enabled "$name" \
    || die "service is disabled: $name"

  plist="$(service_plist "$name")"
  target="$(service_target "$name")"

  [ -f "$plist" ] \
    || die "service is not installed: $plist"

  if ! launchctl print "$target" >/dev/null 2>&1; then
    launchctl bootstrap "$(service_domain)" "$plist"
  fi

  launchctl kickstart -k "$target"
}

stop_service() {
  name="$1"

  require_darwin

  service_exists "$name" \
    || die "unknown service: $name"

  launchctl bootout "$(service_target "$name")" >/dev/null 2>&1 || true
}

acquire_service() {
  name="$1"
  pid="$2"

  require_darwin
  validate_pid "$pid"

  service_exists "$name" \
    || die "unknown service: $name"

  service_enabled "$name" \
    || die "service is disabled: $name"

  # launchd owns autostart services. They never need client leases.
  if service_autostart "$name"; then
    return 0
  fi

  root="$(llm_state_root)"
  leases="$(service_lease_dir "$name")"
  owned="$(service_owned_file "$name")"

  mkdir -p "$leases" "$root/owned"

  acquire_service_lock "$name"
  trap 'release_service_lock' 0 1 2 15

  cleanup_stale_leases "$name"

  lease="$leases/$pid"
  : >"$lease"

  if is_service_running "$name"; then
    release_service_lock
    trap - 0 1 2 15
    return 0
  fi

  if ! start_service "$name"; then
    rm -f "$lease"

    release_service_lock
    trap - 0 1 2 15

    return 1
  fi

  # The service was stopped when we acquired it, so the lease system owns
  # this start and may stop it when the final lease disappears.
  : >"$owned"

  release_service_lock
  trap - 0 1 2 15
}

release_service() {
  name="$1"
  pid="$2"

  require_darwin
  validate_pid "$pid"

  service_exists "$name" \
    || die "unknown service: $name"

  # launchd owns autostart services.
  if service_autostart "$name"; then
    return 0
  fi

  leases="$(service_lease_dir "$name")"
  owned="$(service_owned_file "$name")"

  acquire_service_lock "$name"
  trap 'release_service_lock' 0 1 2 15

  cleanup_stale_leases "$name"

  rm -f "$leases/$pid"

  cleanup_stale_leases "$name"

  if ! has_service_leases "$name" && [ -f "$owned" ]; then
    stop_service "$name"
    rm -f "$owned"
  fi

  release_service_lock
  trap - 0 1 2 15
}

command="${1:-}"

case "$command" in
  services | list)
    list_services
    ;;

  models)
    list_models "${2:-}"
    ;;

  status)
    if [ -n "${2:-}" ]; then
      status_service "$2"
    else
      status_all
    fi
    ;;

  is-running)
    [ -n "${2:-}" ] || die "missing service"
    is_service_running "$2"
    ;;

  acquire)
    [ -n "${2:-}" ] || die "missing service"
    [ -n "${3:-}" ] || die "missing pid"
    acquire_service "$2" "$3"
    ;;

  release)
    [ -n "${2:-}" ] || die "missing service"
    [ -n "${3:-}" ] || die "missing pid"
    release_service "$2" "$3"
    ;;

  start)
    [ -n "${2:-}" ] || die "missing service"
    start_service "$2"
    ;;

  stop)
    [ -n "${2:-}" ] || die "missing service"
    stop_service "$2"
    ;;

  *)
    usage
    exit 1
    ;;
esac
