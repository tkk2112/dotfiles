{{- $profiles := .profiles | default (list) -}}
{{- $llmConfig := .llmConfig | default (dict) -}}
{{- $llmRuntimes := get $llmConfig "runtimes" | default (list) -}}
{{- $llmFeatures := get $llmConfig "features" | default (list) -}}
{{- $completionEnabled := and (has "llm" $profiles) (has "completion" $llmFeatures) -}}

{{- if and (eq .chezmoi.os "darwin") (has "llm" $profiles) -}}
{{- $ports := dict -}}
{{- range $serviceName, $service := .llm.services -}}
{{-   $enabled := $service.enabled -}}

{{-   if eq $service.type "completion" -}}
{{-     $enabled = and $enabled $completionEnabled -}}
{{-   end -}}

{{-   if $enabled -}}
{{-     $port := printf "%v" $service.port -}}
{{-     if hasKey $ports $port -}}
{{-       fail (printf "LLM services %s and %s use duplicate port %s" (get $ports $port) $serviceName $port) -}}
{{-     end -}}
{{-     $_ := set $ports $port $serviceName -}}
{{-   end -}}
{{- end -}}
#!/bin/sh
set -eu

SERVICE_NAME="${1:-}"

die() {
  printf 'dotfiles-llm-launch: %s\n' "$*" >&2
  exit 1
}

[ -n "$SERVICE_NAME" ] || die "missing service name"

case "$SERVICE_NAME" in
{{- range $serviceName, $service := .llm.services }}
    {{- $enabled := $service.enabled }}

    {{- if eq $service.type "completion" }}
    {{-   $enabled = and $enabled $completionEnabled }}
    {{- end }}

    {{- if $enabled }}
  {{ $serviceName }})
    {{- $modelID := $service.model }}
    {{- $model := dict }}

    {{- range $.llm.models }}
    {{-   if eq .id $modelID }}
    {{-     $model = . }}
    {{-   end }}
    {{- end }}

    {{- if not (hasKey $model "id") }}
    {{-   fail (printf "unknown LLM model %s for service %s" $modelID $serviceName) }}
    {{- end }}

    {{- if ne $model.type $service.type }}
    {{-   fail (printf "LLM service %s has type %s but model %s has type %s" $serviceName $service.type $modelID $model.type) }}
    {{- end }}

    {{- $backend := $service.backend }}

    {{- if eq $service.type "completion" }}
    {{-   if not (has $backend $llmRuntimes) }}
    {{-     if eq (len $llmRuntimes) 1 }}
    {{-       $backend = index $llmRuntimes 0 }}
    {{-     else }}
    {{-       fail (printf "LLM completion service %s cannot resolve a runtime from %s" $serviceName ($llmRuntimes | toJson)) }}
    {{-     end }}
    {{-   end }}
    {{- end }}

    {{- if not (hasKey $model.backends $backend) }}
    {{-   fail (printf "LLM model %s does not support backend %s" $modelID $backend) }}
    {{- end }}

    {{- $artifact := index $model.backends $backend }}
    BACKEND="{{ $backend }}"
    MODEL="{{ $artifact.model }}"
    CTX_SIZE="{{ $model.ctx_size }}"
    PORT="{{ $service.port }}"
    ;;
    {{- end }}
{{- end }}
  *)
    die "unknown service: $SERVICE_NAME"
    ;;
esac

case "$PORT" in
  ''|*[!0-9]*)
    die "invalid port for $SERVICE_NAME: $PORT"
    ;;
esac

PATH="/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

case "$BACKEND" in
  llama_cpp)
    SERVER="$(command -v llama-server || true)"
    [ -n "$SERVER" ] || die "llama-server not found"

    exec /usr/bin/env -i \
      HOME="$HOME" \
      PATH="$PATH" \
      TMPDIR=/tmp \
      "$SERVER" \
      --hf-repo "$MODEL" \
      --host 127.0.0.1 \
      --port "$PORT" \
      --ctx-size "$CTX_SIZE" \
      --parallel 1 \
      --cors-origins localhost \
      --no-cors-credentials \
      --no-agent \
      --no-webui
    ;;

  mlx)
    SERVER="$(command -v mlx_lm.server || true)"
    [ -n "$SERVER" ] || die "mlx_lm.server not found"

    exec /usr/bin/env -i \
      HOME="$HOME" \
      PATH="$PATH" \
      TMPDIR=/tmp \
      "$SERVER" \
      --model "$MODEL" \
      --host 127.0.0.1 \
      --port "$PORT"
    ;;

  *)
    die "unsupported backend for $SERVICE_NAME: $BACKEND"
    ;;
esac
{{- end }}
