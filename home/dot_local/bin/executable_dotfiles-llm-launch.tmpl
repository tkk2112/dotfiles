{{- $profiles := .profiles | default (list) -}}
{{- $llmConfig := .llmConfig | default (dict) -}}
{{- $llmEngines := get $llmConfig "engines" | default (list) -}}
{{- $llmFeatures := get $llmConfig "features" | default (list) -}}
{{- $llmDisabledRuntimes := get $llmConfig "disabledRuntimes" | default (list) -}}

{{- if and (eq .chezmoi.os "darwin") (has "llm" $profiles) -}}
{{- $ports := dict -}}

{{- range $runtimeName, $runtime := .llm.runtimes -}}
{{-   $enabled := true -}}
{{-   if hasKey $runtime "enabled" -}}
{{-     $enabled = $runtime.enabled -}}
{{-   end -}}
{{-   $enabled = and $enabled (has $runtime.feature $llmFeatures) -}}
{{-   if has $runtimeName $llmDisabledRuntimes -}}
{{-     $enabled = false -}}
{{-   end -}}

{{-   if $enabled -}}
{{-     $port := printf "%v" $runtime.port -}}
{{-     if hasKey $ports $port -}}
{{-       fail (printf "LLM runtimes %s and %s use duplicate port %s" (get $ports $port) $runtimeName $port) -}}
{{-     end -}}
{{-     $_ := set $ports $port $runtimeName -}}
{{-   end -}}
{{- end -}}

#!/bin/sh
set -eu

RUNTIME_NAME="${1:-}"

die() {
  printf 'dotfiles-llm-launch: %s\n' "$*" >&2
  exit 1
}

[ -n "$RUNTIME_NAME" ] || die "missing runtime name"

case "$RUNTIME_NAME" in
{{- range $runtimeName, $runtime := .llm.runtimes }}
    {{- $enabled := true }}
    {{- if hasKey $runtime "enabled" }}
    {{-   $enabled = $runtime.enabled }}
    {{- end }}
    {{- $enabled = and $enabled (has $runtime.feature $llmFeatures) }}
    {{- if has $runtimeName $llmDisabledRuntimes }}
    {{-   $enabled = false }}
    {{- end }}

    {{- if $enabled }}
  {{ $runtimeName }})
    {{- $modelID := $runtime.model }}
    {{- $model := dict }}

    {{- range $.llm.models }}
    {{-   if eq .id $modelID }}
    {{-     $model = . }}
    {{-   end }}
    {{- end }}

    {{- if not (hasKey $model "id") }}
    {{-   fail (printf "unknown LLM model %s for runtime %s" $modelID $runtimeName) }}
    {{- end }}

    {{- if and (eq $runtime.feature "completion") (ne $model.kind "generative") }}
    {{-   fail (printf "LLM runtime %s for feature completion requires model kind generative, got %s" $runtimeName $model.kind) }}
    {{- end }}

    {{- if ne $model.kind "generative" }}
    {{-   fail (printf "LLM runtime %s uses unsupported model kind %s" $runtimeName $model.kind) }}
    {{- end }}

    {{- $candidateEngines := list }}

    {{- range $candidate := $llmEngines }}
    {{-   if hasKey $model.engines $candidate }}
    {{-     $candidateEngines = append $candidateEngines $candidate }}
    {{-   end }}
    {{- end }}

    {{- if eq (len $candidateEngines) 0 }}
    {{-   fail (printf "LLM runtime %s model %s has no selected supported engine" $runtimeName $modelID) }}
    {{- end }}

    {{- $engine := "" }}

    {{- if and
          (hasKey $model "default_engine")
          (has $model.default_engine $candidateEngines)
    }}
    {{-   $engine = $model.default_engine }}
    {{- else if eq (len $candidateEngines) 1 }}
    {{-   $engine = index $candidateEngines 0 }}
    {{- else }}
    {{-   fail (printf "LLM runtime %s cannot resolve engine from %s" $runtimeName ($candidateEngines | toJson)) }}
    {{- end }}

    {{- $artifact := index $model.engines $engine }}

    ENGINE="{{ $engine }}"
    MODEL="{{ $artifact.model }}"
    CONTEXT="{{ $model.context }}"
    PORT="{{ $runtime.port }}"
    ;;
    {{- end }}
{{- end }}

  *)
    die "unknown runtime: $RUNTIME_NAME"
    ;;
esac

case "$PORT" in
  ''|*[!0-9]*)
    die "invalid port for $RUNTIME_NAME: $PORT"
    ;;
esac

PATH="/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

case "$ENGINE" in
  llama_cpp)
    SERVER="$(command -v llama-server || true)"
    [ -n "$SERVER" ] || die "llama-server not found"

    exec /usr/bin/env -i \
      HOME="$HOME" \
      PATH="$PATH" \
      TMPDIR=/tmp \
      "$SERVER" \
      --hf-repo "$MODEL" \
      --host 127.0.0.1 \
      --port "$PORT" \
      --ctx-size "$CONTEXT" \
      --parallel 1 \
      --cors-origins localhost \
      --no-cors-credentials \
      --no-agent \
      --no-webui
    ;;

  mlx)
    SERVER="$(command -v mlx_lm.server || true)"
    [ -n "$SERVER" ] || die "mlx_lm.server not found"

    exec /usr/bin/env -i \
      HOME="$HOME" \
      PATH="$PATH" \
      TMPDIR=/tmp \
      "$SERVER" \
      --model "$MODEL" \
      --host 127.0.0.1 \
      --port "$PORT"
    ;;

  *)
    die "unsupported engine for $RUNTIME_NAME: $ENGINE"
    ;;
esac
{{- end }}
