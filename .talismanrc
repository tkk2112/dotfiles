threshold: high

version: "1.0"

fileignoreconfig:
  - filename: home/.ignored-ssh.yaml.age
    checksum: 6ed7b5276333bc4f9eaf2d23ac4b3ed63e0d0ff22f3e09a90ba7ad6557b2955a

  - filename: home/private_dot_ssh/conf.d/encrypted_10-specific.conf.tmpl.age
    checksum: 06e3cee6e156a840a202b148b2e2151f80632deccec853fb85d0be95407c21f1

  - filename: home/private_dot_ssh/conf.d/encrypted_20-vacuums.conf.tmpl.age
    checksum: bdfa22bfbc808cd7f872b19bce608d17525fb0a997e261830f1bb480126e9c85

  - filename: home/private_dot_ssh/conf.d/encrypted_30-void.conf.tmpl.age
    checksum: 1f2860acb224f1a5cce3a517f9e3a695d6db48a2e4a90c6d29597c81e3d7d7c9

  - filename: home/private_dot_ssh/conf.d/encrypted_40-legacy-rsa.conf.tmpl.age
    checksum: e1e22ef26699b3e6e406c9674ab5e0c2eda0f110fbf268a5e8ece2ad59d4087d

  - filename: home/private_dot_ssh/conf.d/encrypted_50-remarkable.conf.tmpl.age
    checksum: 47082123480ff1439e081ddbaecc4b8a49ca14fc3544769010c4e38393ea8a8d

  - filename: home/private_dot_ssh/conf.d/encrypted_80-regional.conf.tmpl.age
    checksum: eec0e0ad3685e9746633c1ec7b94bdb99f418a2d4df23f8d5798e5ab989b29c1

  - filename: home/dot_zshenv.tmpl
    ignore_detectors:
      - filename

  - filename: home/dot_direnvrc
    ignore_detectors:
      - filename

  - filename: .github/workflows/main.yml
    allowed_patterns:
      - 'uses:[[:space:]]+[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+@[0-9a-f]{40}'

  - filename: .github/workflows/pr.yml
    allowed_patterns:
      - 'uses:[[:space:]]+[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+@[0-9a-f]{40}'

  - filename: home/.chezmoiscripts/run_once_before_05-chezmoi-age-key.sh.tmpl
    allowed_patterns:
      - "share_id='[A-Za-z0-9_-]+'"

  - filename: home/.chezmoidata.yaml
    allowed_patterns:
      - 'defaultAuthorizedKey:[[:space:]]+ssh-ed25519[[:space:]]+[A-Za-z0-9+/]+([[:space:]]+[^[:space:]]+)?'

  - filename: home/.chezmoi.toml.tmpl
    allowed_patterns:
      - 'age1[023456789acdefghjklmnpqrstuvwxyz]+'
